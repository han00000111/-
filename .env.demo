# 演示构建：动态 mock runtime + mock service，不连接真实 API/WS。
VITE_APP_MODE=demo
# 控制旧 mock runtime 定时器；true 时按固定间隔更新演示数据。
VITE_ENABLE_MOCK_RUNTIME=true
# true：services 返回本地 mock；false：已接入的异步 service 请求 VITE_API_BASE_URL。
VITE_USE_MOCK_SERVICE=true
# 真实 API 基础地址。mock service 开启时可留空。
VITE_API_BASE_URL=
VITE_REQUEST_TIMEOUT=10000
# runtimeSource：mock=动态演示，static=静态初始数据，ws=静态数据+WS 增量。
VITE_RUNTIME_SOURCE=mock
# ws 模式需同时设置为 true 并填写 VITE_WS_RUNTIME_URL。
VITE_ENABLE_WS_RUNTIME=false
VITE_WS_RUNTIME_URL=
VITE_WS_RECONNECT_MAX=5
VITE_WS_RECONNECT_INTERVAL=3000
