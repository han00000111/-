# 正式构建：默认静态 mock 数据，不启 mock 定时器，不连接 WebSocket。
VITE_APP_MODE=production
VITE_ENABLE_MOCK_RUNTIME=false
# 当前尚无完整真实后端，正式构建仍使用 mock service。
# 接入真实 API 时改为 false，并填写 VITE_API_BASE_URL；未接入的业务域仍需按 docs/service-adapter-plan.md 完成适配。
VITE_USE_MOCK_SERVICE=true
# 真实 API 基础地址，例如 https://api.example.com；mock service 开启时可留空。
VITE_API_BASE_URL=
VITE_REQUEST_TIMEOUT=10000
# runtimeSource：mock=动态演示，static=静态初始数据，ws=静态数据+WS 增量。
# 当前默认 static（不启定时器/不连 WS）。接真实实时通道时改为：
# VITE_RUNTIME_SOURCE=ws / VITE_ENABLE_WS_RUNTIME=true / VITE_WS_RUNTIME_URL=ws://后端地址/ws/runtime
VITE_RUNTIME_SOURCE=static
VITE_ENABLE_WS_RUNTIME=false
VITE_WS_RUNTIME_URL=
VITE_WS_RECONNECT_MAX=5
VITE_WS_RECONNECT_INTERVAL=3000
