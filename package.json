{
    "scripts": {
        "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
        "dev:local": "vite --host 127.0.0.1 --port 5173 --strictPort",
        "dev:lan": "vite --host 0.0.0.0 --port 5173 --strictPort",
        "build": "npm run build:prod",
        "build:prod": "vite build --mode production && node scripts/copy-404.cjs dist",
        "build:demo": "vite build --mode demo && node scripts/copy-404.cjs dist-demo",
        "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
        "preview:prod": "vite preview --outDir dist --host 127.0.0.1 --port 5173 --strictPort",
        "preview:demo": "vite preview --outDir dist-demo --host 127.0.0.1 --port 5173 --strictPort",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
        "format:check": "prettier --check \"src/**/*.{js,jsx,css}\"",
        "check": "npm run lint && npm run build:prod"
    },
    "engines": {
        "node": "22.x"
    },
    "dependencies": {
        "@vitejs/plugin-react": "4.3.4",
        "lucide-react": "0.468.0",
        "react": "18.2.0",
        "react-dom": "18.2.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^9.1.2",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.26",
        "globals": "^15.15.0",
        "prettier": "^3.8.4",
        "vite": "^5.4.21",
        "vite-plugin-singlefile": "^2.3.3"
    },
    "name": "robot-integrated-management-platform"
}
